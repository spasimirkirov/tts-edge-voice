{
  "plugin_name": "Edge TTS Provider",
  "version": "1.2.0",
  "engine_type": "cli_wrapper",
  "executable": "EdgeVoiceTTS.exe",
  "commands": {
    "get_voices": "--list-voices",
    "generate": "--voice {voice_id} --text \"{text}\" --output \"{file_path}\" --speed {speed} --pitch {pitch}",
    "serve": "--serve"
  },
  "voices": {
    "catalog_path": "voices.json"
  },
  "capabilities": {
    "tuning": [
      "speed",
      "pitch"
    ],
    "persistent_worker": true
  },
  "output_format": "mp3",
  "author": "spasimirkirov",
  "update": {
    "github": "spasimirkirov/tts-edge-voice"
  }
}
